# This example keeps the existing canvas/button system unchanged.
# Open the import panel with I, then drag a WAV/OGG/FLAC/AIFF file onto the import button.
set {project1} to "default"
set {import_status} to "Drop a file onto the Import Sound button."

if {buttonsound1::%{project1}%} is not set:
    set {buttonsound1::%{project1}%} to none

on press key "I":
    open canvas "AudioImport"

on file attach:
    if mouse cursor is over button "sound_import_btn":
        set {buttonsound1::%{project1}%} to {_attached_file}
        set {import_status} to "Sound imported for profile {project1}."
    else:
        set {import_status} to "Drop the file directly on the Import Sound button."

on click button "play_sound_btn":
    if {buttonsound1::%{project1}%} is set:
        play sound {buttonsound1::%{project1}%}
        set {import_status} to "Playback requested for profile {project1}."
    else:
        set {import_status} to "Import a sound first."

on press key "ESCAPE":
    close canvas "AudioImport"

canvas "AudioImport":
    create panel at (340, 190) size (600, 350) color (14, 23, 39, 245)
    create text "<#59ccff>Audio Import</#59ccff>" at (375, 220) font size 26
    create text "Drag an audio file from your file manager onto this button." at (375, 265) font size 16
    create text "Status: {import_status}" at (375, 292) font size 14
    create button "sound_import_btn" at (375, 335) size (520, 56) label "Drop audio file here"
    create button "play_sound_btn" at (375, 410) size (250, 48) label "Play imported sound"
