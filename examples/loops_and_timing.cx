# Press SPACE to run the delayed countdown.
# Each wait yields to the engine: rendering and input are not blocked.
on press key "SPACE":
    set {_num} to 5
    loop 5 times:
        send "%{_num}%"
        add 1 to {_num}
        wait 1 second
    send "Countdown over!"

# Periodic work is scheduled separately from the fixed on tick event.
every 1 second:
    add 1 to {seconds_elapsed}

# Use on tick only for lightweight work that needs each logic update.
on tick:
    add 1 to {^logic_steps}
